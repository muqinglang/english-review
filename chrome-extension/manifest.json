{
  "manifest_version": 3,
  "name": "English Tranning Review Sync",
  "version": "1.0.5",
  "description": "Automatically saves explicit English review items from completed ChatGPT practice sessions.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://english-review-three.vercel.app/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": {"default_title": "English Review Sync"}
}
