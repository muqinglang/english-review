# Supabase project settings — server only, never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used by worker routes to hash and verify device tokens.
WORKER_TOKEN_PEPPER=replace-with-a-long-random-secret

# Preferred root secret for encrypting third-party credentials at rest.
# Use a separate high-entropy value (for example, 32 random bytes encoded as hex).
# If omitted, WORKER_TOKEN_PEPPER is used through a context-separated HKDF fallback.
INTEGRATION_SECRET_KEY=replace-with-a-separate-long-random-secret
